# Sentinel AML — environment configuration example
# Copy to .env and/or export these in your shell / CI. Never commit real secrets.

# --- Database (matches docker-compose.yml defaults) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel

# docker-compose reads these:
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# --- Application user credentials (RBAC bootstrap) ---
# Override these in any non-local environment.
SENTINEL_ADMIN_PASSWORD=admin123
SENTINEL_SUPERVISOR_PASSWORD=supervisor123
SENTINEL_ANALYST_PASSWORD=analyst123
